{
  "data_asset_type": null,
  "expectation_suite_name": "gold_fct_trips_suite",
  "expectations": [
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": {
        "min_value": 500000,
        "max_value": 12000000
      },
      "meta": {
        "notes": "Row count must reconcile with Bronze within the same monthly partition."
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "trip_id"
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "pickup_at"
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "pu_location_id"
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "pu_location_id",
        "min_value": 1,
        "max_value": 265,
        "mostly": 0.999
      },
      "meta": {
        "notes": "All pickup locations should be valid TLC zone IDs (1–265)."
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "do_location_id",
        "min_value": 1,
        "max_value": 265,
        "mostly": 0.999
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_mean_to_be_between",
      "kwargs": {
        "column": "tip_pct",
        "min_value": 5,
        "max_value": 30
      },
      "meta": {
        "notes": "Average tip percentage should stay in the 5–30% band across months."
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "tip_pct",
        "min_value": 0,
        "max_value": 200,
        "mostly": 0.999
      },
      "meta": {
        "notes": "Tip rate above 200% is almost certainly a data error."
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "duration_min",
        "min_value": 0,
        "max_value": 600,
        "mostly": 0.999
      },
      "meta": {
        "notes": "Trips over 10 hours (600 min) are likely sensor/meter errors."
      }
    },
    {
      "expectation_type": "expect_column_mean_to_be_between",
      "kwargs": {
        "column": "total_amount",
        "min_value": 10,
        "max_value": 50
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "_ingested_at"
      },
      "meta": {
        "notes": "Provenance must be intact end-to-end — ingestion timestamp carried from Bronze."
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "_transformed_at"
      },
      "meta": {}
    }
  ],
  "ge_cloud_id": null,
  "meta": {
    "great_expectations_version": "0.18.0"
  }
}
